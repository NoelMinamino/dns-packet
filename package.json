{
  "name": "@noelminamino/dns-packet",
  "version": "6.5.0-nm.0",
  "description": "An abstract-encoding compliant module for encoding / decoding DNS packets",
  "author": "Mathias Buus",
  "license": "MIT",
  "repository": "NoelMinamino/dns-packet",
  "homepage": "https://github.com/NoelMinamino/dns-packet",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./buffer_utils.js": {
      "types": "./buffer_utils.mjs",
      "import": "./buffer_utils.mjs",
      "require": "./buffer_utils.js"
    },
    "./classes.js": {
      "types": "./classes.d.ts",
      "import": "./classes.mjs",
      "require": "./classes.js"
    },
    "./opcodes.js": {
      "types": "./opcodes.d.ts",
      "import": "./opcodes.mjs",
      "require": "./opcodes.js"
    },
    "./optioncodes.js": {
      "types": "./optioncodes.d.ts",
      "import": "./optioncodes.mjs",
      "require": "./optioncodes.js"
    },
    "./rcodes.js": {
      "types": "./rcodes.d.ts",
      "import": "./rcodes.mjs",
      "require": "./rcodes.js"
    },
    "./types.js": {
      "types": "./types.d.ts",
      "import": "./types.mjs",
      "require": "./types.js"
    },
    "./presentation.js": {
      "types": "./presentation.d.ts",
      "import": "./presentation.mjs",
      "require": "./presentation.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf coverage",
    "lint": "eslint . && tsc -p types",
    "test": "npm run lint && npm run unit",
    "unit": "tape test.mjs",
    "coverage": "c8 -r html npm test",
    "prepare": "npx @leichtgewicht/esm2umd"
  },
  "dependencies": {
    "@leichtgewicht/ip-codec": "^2.0.4",
    "utf8-codec": "^1.0.0"
  },
  "devDependencies": {
    "@leichtgewicht/esm2umd": "^0.4.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "neostandard": "^0.14.1",
    "tape": "^5.6.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dns",
    "packet",
    "encodings",
    "encoding",
    "encoder",
    "abstract-encoding"
  ],
  "contributors": [
    "Noel Minamino (https://github.com/NoelMinamino)"
  ],
  "overrides": {
    "tape": {
      "glob": "^13.0.6"
    }
  }
}
